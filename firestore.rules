rules_version = '2';
// KYTALYST: each user reads and writes only their own profile and deals.
// Scan usage counters are written only by the kytalystScan function (admin SDK).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['assumptions', 'email', 'updatedAt'])
        && (!('assumptions' in request.resource.data) || request.resource.data.assumptions is map);

      match /deals/{dealId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && dealId.size() <= 120
          && request.resource.data.id == dealId
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 200
          && request.resource.data.status in ['analyzing', 'watching', 'offer', 'contract', 'bought', 'passed']
          && request.resource.data.purchasePrice is number
          && request.resource.data.arv is number
          && (request.resource.data.hipshot == null || request.resource.data.hipshot is number)
          && request.resource.data.scan is map
          && request.resource.data.keys().hasOnly(['id', 'address', 'status', 'purchasePrice', 'arv', 'arvOverridden',
               'hipshot', 'assumptions', 'results', 'scan', 'createdAt', 'updatedAt']);
      }
    }

    match /usage/{uid}/{document=**} {
      allow read: if owner(uid);
      allow write: if false;
    }
  }
}
